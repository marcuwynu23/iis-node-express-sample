<configuration>
    <system.webServer>
        <handlers>
            <add name="iisnode"
                 path="server.js"
                 verb="*"
                 modules="iisnode" />
        </handlers>

        <rewrite>
            <rules>
                <rule name="sendToNode" stopProcessing="true">
                    <match url=".*" />
                    <action type="Rewrite" url="server.js" />
                </rule>
            </rules>
        </rewrite>

        <iisnode
            devErrorsEnabled="true"
            loggingEnabled="true"
            logDirectory="iisnode" />
    </system.webServer>
</configuration>